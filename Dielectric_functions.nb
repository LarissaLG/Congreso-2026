Cell[CellGroupData[{

Cell["Datos beta y H2O -> Parte real", "Section",
 CellChangeTimes->{{3.9851911506942525`*^9, 3.985191162216729*^9}, {
  3.98519393150478*^9, 
  3.9851939485551357`*^9}},ExpressionUUID->"0c9a9fa9-e039-4e83-b93c-\
664e75158ec9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Funci\[OAcute]n", " ", "que", " ", "da", " ", "la", " ", "parte", " ", 
    "real", " ", "del", " ", "\[IAcute]ndice", " ", "de", " ", 
    "refracci\[OAcute]n", " ", "a", " ", "partir", " ", "de", " ", "la", " ", 
    "relaci\[OAcute]n", " ", "de", " ", "Meinke", " ", "2006"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"datosH2O", "=", 
     RowBox[{
     "Import", "[", 
      "\"\<C:\\\\Users\\\\danal\\\\Documents\\\\Grupo_Nanoplasm\[OAcute]nica\\\
\\Tesis\\\\Refractive index\\\\H2O_n.csv\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datosBeta", "=", 
     RowBox[{
     "Import", "[", 
      "\"\<C:\\\\Users\\\\danal\\\\Documents\\\\Grupo_Nanoplasm\[OAcute]nica\\\
\\Tesis\\\\Refractive index\\\\Beta_parameter_ReN_Erythrocytes.csv\>\"", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos1Beta", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"datosBeta", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos1H2O", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"datosH2O", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos2Beta", "=", 
     RowBox[{"h", " ", 
      RowBox[{"c", "/", 
       RowBox[{"datos1Beta", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datos2H2O", "=", 
     RowBox[{"h", " ", 
      RowBox[{"c", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"datos1H2O", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "*", "1000"}], 
        ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"beta", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"datos2Beta", ",", 
        RowBox[{"datos1Beta", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"h2o", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"datos2H2O", ",", 
         RowBox[{"datos1H2O", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Se", " ", "va", " ", "a", " ", "encontrar", " ", "la", " ", "parte", " ",
      "real", " ", "empleando", " ", "la", " ", "relaci\[OAcute]n", " ", "de",
      " ", "Meinke", " ", "2006"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"parteRe", "[", 
      RowBox[{"x_", ",", "C_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"h2o", "[", "x", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"beta", "[", "x", "]"}], "*", "C"}], ")"}], "+", "1"}], 
       ")"}]}]}], ";"}]}]}]], "Code",
 CellChangeTimes->{3.985193967635079*^9},
 CellLabel->
  "In[202]:=",ExpressionUUID->"2de85fe5-36a9-4f00-9f63-a219212bf30d"],

