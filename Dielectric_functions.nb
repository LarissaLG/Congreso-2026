Cell[CellGroupData[{

Cell["Funciones generales", "Section",
 CellChangeTimes->{{3.9851905395759425`*^9, 
  3.985190545244315*^9}},ExpressionUUID->"73b8ff9d-e3d5-4e7d-b6c9-\
b1b15ed473d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"epsRe", "[", 
    RowBox[{"parteRe_", ",", "parteIm_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"parteRe", "[", "x", "]"}], "^", "2"}], "-", 
    RowBox[{
     RowBox[{"parteIm", "[", "x", "]"}], "^", "2"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"epsIm", "[", 
    RowBox[{"parteRe_", ",", "parteIm_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{"2", "*", 
     RowBox[{"parteRe", "[", "x", "]"}], "*", 
     RowBox[{"parteIm", "[", "x", "]"}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eps", "[", 
    RowBox[{"parteRe_", ",", "parteIm_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"parteRe", "[", "x", "]"}], "+", 
      RowBox[{"I", " ", 
       RowBox[{"parteIm", "[", "x", "]"}]}]}], ")"}], "^", "2"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.999172648460559*^9, 3.9991726521049175`*^9}},
 CellLabel->
  "In[190]:=",ExpressionUUID->"ecdc7e63-33be-4a35-a3c8-0864e8bd98c4"],

Cell[BoxData[
 RowBox[{"\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Funci\[OAcute]n", " ", "para", " ", "encontrar", " ", "los", " ", 
    "m\[AAcute]ximos", " ", "alrededor", " ", "de", " ", "intervalos", " ", 
    "dados"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]0i", "[", 
      RowBox[{"epsFunc_", ",", " ", "intervalos_", ",", " ", "tolRes_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"GoldenSectionSearchMax", "[", 
        RowBox[{
        "epsFunc", ",", " ", "#1", ",", " ", "#2", ",", " ", "tolRes"}], 
        "]"}], " ", "&"}], " ", "@@@", " ", "intervalos"}]}], ";"}], 
   "\[IndentingNewLine]", "  ", "\n", 
   RowBox[{"(*", 
    RowBox[{"Parte", " ", "imaginaria", " ", "de", " ", "lorentziana"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"lorentzIm", "[", 
     RowBox[{"omega_", ",", "omega0_", ",", "gamma_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"gamma", " ", "omega"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"omega0", "^", "2"}], "-", 
          RowBox[{"omega", "^", "2"}]}], ")"}], "^", "2"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gamma", " ", "omega"}], ")"}], "^", "2"}]}], ")"}]}]}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Suma", " ", "lorentzianas"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"lorentzSumIm", "[", 
     RowBox[{
     "omega_", ",", " ", "A_List", ",", " ", "omega0_List", ",", " ", 
      "gamma_List"}], "]"}], " ", ":=", "  ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"A", "[", 
        RowBox[{"[", "i", "]"}], "]"}], " ", "*", " ", 
       RowBox[{"lorentzIm", "[", 
        RowBox[{"omega", ",", " ", 
         RowBox[{"omega0", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
         RowBox[{"gamma", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", 
        RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}]}]}]}]], "Code",
 CellChangeTimes->{{3.985190303996364*^9, 3.9851903106963463`*^9}, {
  3.985190565997864*^9, 3.9851905988255806`*^9}, {3.9851906379758415`*^9, 
  3.9851909105743084`*^9}, {3.985190991785838*^9, 3.985191000694194*^9}, {
  3.985191103045726*^9, 3.9851911054880342`*^9}, {3.985191370360274*^9, 
  3.985191374813136*^9}, {3.9851917684963145`*^9, 3.985191771084342*^9}, {
